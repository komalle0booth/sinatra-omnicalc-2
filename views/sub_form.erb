<h1>New subtraction</h1>

<form action="/wizard_subtract">
  <label for="sub_form_first_number">
    Subtract this:
  </label>
  <input id="sub_form_first_number" name="sub_first_number" type="text">
   
   <label for="sub_form_second_number">
    from this:
  </label>
  <input id="sub_form_second_number" name="sub_second_number" type="text">

  <button>
    Subtract!
  </button>
</form>
